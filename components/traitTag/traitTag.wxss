.trait-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.tag-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.tag-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #3A1F14;
}

.tag-level {
  font-size: 24rpx;
  font-weight: 600;
  color: #8B7355;
}

.trait-tag-orange {
  background: #FFF0E6;
}

.trait-tag-blue {
  background: #EBF4FA;
}

.trait-tag-green {
  background: #E8F5E9;
}

.trait-tag-purple {
  background: #F3E5F5;
}

.trait-tag-yellow {
  background: #FFF8E1;
}
