.result-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(58, 31, 20, 0.06);
  position: relative;
  border: 3rpx solid transparent;
}

.result-card-winner {
  border-color: #FFB088;
  background: linear-gradient(180deg, #FFF8F2 0%, #FFFFFF 100%);
  box-shadow: 0 8rpx 28rpx rgba(255, 122, 69, 0.18);
}

.result-card-normal {
  border-color: #B8D4EC;
  background: linear-gradient(180deg, #F5FAFD 0%, #FFFFFF 100%);
  box-shadow: 0 4rpx 16rpx rgba(91, 155, 213, 0.1);
}

.card-crown {
  position: absolute;
  top: -24rpx;
  width: 40rpx;
  height: 40rpx;
  filter: drop-shadow(0 2rpx 6rpx rgba(255, 165, 0, 0.4));
}

.card-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  overflow: hidden;
}

.avatar-winner {
  background: linear-gradient(135deg, #FFE8D6, #FFD4B8);
  box-shadow: 0 4rpx 12rpx rgba(255, 179, 71, 0.25);
}

.avatar-normal {
  background: linear-gradient(135deg, #E8F4FD, #D4ECFA);
  box-shadow: 0 4rpx 12rpx rgba(91, 155, 213, 0.2);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #E8D5C4;
  position: relative;
}

.avatar-placeholder::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #D4BFA8;
  transform: translate(-50%, -70%);
}

.avatar-placeholder::after {
  content: '';
  position: absolute;
  bottom: 14rpx;
  left: 50%;
  width: 56rpx;
  height: 28rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #D4BFA8;
  transform: translateX(-50%);
}

.card-nickname {
  font-size: 28rpx;
  font-weight: 700;
  color: #3A1F14;
  margin-bottom: 8rpx;
}

.card-score {
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.1;
  margin-bottom: 12rpx;
}

.card-type-tag {
  padding: 6rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}

.type-tag-winner {
  background: #FFF0E6;
}

.type-tag-normal {
  background: #EBF4FA;
}

.type-tag-text {
  font-size: 22rpx;
  font-weight: 600;
  color: #3A1F14;
}

.card-role {
  font-size: 22rpx;
  color: #8B7355;
}
