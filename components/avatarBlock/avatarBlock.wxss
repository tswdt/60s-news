.avatar-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.avatar-wrap {
  position: relative;
  border-radius: 50%;
  overflow: visible;
  flex-shrink: 0;
}

.avatar-default {
  width: 88rpx;
  height: 88rpx;
}

.avatar-large {
  width: 120rpx;
  height: 120rpx;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE8D6, #FFD4B8);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.placeholder-head {
  width: 36%;
  height: 36%;
  border-radius: 50%;
  background: #D4BFA8;
  position: absolute;
  top: 22%;
  left: 50%;
  transform: translateX(-50%);
}

.placeholder-body {
  width: 56%;
  height: 28%;
  border-radius: 28rpx 28rpx 0 0;
  background: #D4BFA8;
  position: absolute;
  bottom: 12%;
  left: 50%;
  transform: translateX(-50%);
}

.avatar-large .placeholder-head {
  width: 32%;
  height: 32%;
}

.avatar-large .placeholder-body {
  width: 52%;
  height: 26%;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
}

.avatar-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  background: linear-gradient(135deg, #FF7A45, #FF4D2E);
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 46, 0.3);
}

.badge-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.avatar-nickname {
  font-size: 24rpx;
  font-weight: 600;
  color: #3A1F14;
}
