.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.error-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #FFF0E6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.error-icon {
  width: 48rpx;
  height: 48rpx;
  position: relative;
}

.error-icon-x {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 40rpx;
  height: 6rpx;
  background: #FF7A45;
  border-radius: 3rpx;
}

.x-left {
  transform: translate(-50%, -50%) rotate(45deg);
}

.x-right {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.error-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3A1F14;
  margin-bottom: 8rpx;
}

.error-desc {
  font-size: 26rpx;
  color: #8B7355;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.error-action {
  background: linear-gradient(135deg, #FF7A45, #FF4D2E);
  padding: 16rpx 48rpx;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 77, 46, 0.25);
}

.error-action:active {
  transform: scale(0.98);
  opacity: 0.85;
}

.error-action-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFFFFF;
}
