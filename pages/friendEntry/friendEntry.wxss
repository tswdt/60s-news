.page-container {
  min-height: 100vh;
  background-color: #FFF7F0;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  padding: 32rpx;
  padding-top: 24rpx;
}

.entry-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.entry-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #3A1F14;
  margin-bottom: 16rpx;
}

.entry-title .highlight {
  color: #FF7A45;
}

.entry-capsule {
  background: linear-gradient(135deg, #FFF0E6, #FFE8D6);
  padding: 10rpx 28rpx;
  border-radius: 24rpx;
}

.capsule-text {
  font-size: 24rpx;
  color: #FF7A45;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.explain-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(58, 31, 20, 0.05);
}

.explain-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.explain-line:last-child {
  margin-bottom: 0;
}

.explain-dot {
  font-size: 28rpx;
  flex-shrink: 0;
}

.explain-text {
  font-size: 28rpx;
  color: #3A1F14;
  line-height: 1.5;
  font-weight: 500;
}

.versus-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(58, 31, 20, 0.08);
  position: relative;
  overflow: hidden;
}

.versus-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(255, 122, 69, 0.03) 0%, rgba(255, 122, 69, 0.08) 100%);
  pointer-events: none;
}

.versus-player {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  position: relative;
  z-index: 1;
}

.versus-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.versus-avatar.left {
  background: linear-gradient(135deg, #FFE8D6, #FFD4B8);
  box-shadow: 0 6rpx 20rpx rgba(255, 122, 69, 0.2);
}

.versus-avatar.right {
  background: linear-gradient(135deg, #E8F4FD, #D4ECFA);
  box-shadow: 0 6rpx 20rpx rgba(91, 155, 213, 0.2);
}

.versus-img {
  width: 110rpx;
  height: 110rpx;
}

.versus-emoji {
  font-size: 64rpx;
}

.versus-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #3A1F14;
}

.versus-badge {
  padding: 4rpx 18rpx;
  border-radius: 16rpx;
}

.versus-badge.done {
  background: #E8F5E9;
}

.versus-badge.waiting {
  background: #FFF0E6;
}

.badge-text {
  font-size: 22rpx;
  font-weight: 600;
}

.versus-badge.done .badge-text {
  color: #4CAF50;
}

.versus-badge.waiting .badge-text {
  color: #FF7A45;
}

.versus-center {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  position: relative;
  z-index: 1;
}

.versus-vs {
  font-size: 52rpx;
  font-weight: 900;
  color: #FF7A45;
  text-shadow: 0 2rpx 8rpx rgba(255, 122, 69, 0.3);
}

.dimensions-section {
  margin-bottom: 16rpx;
}

.dim-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3A1F14;
  margin-bottom: 20rpx;
}

.dim-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.dim-card {
  width: calc(33.33% - 12rpx);
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(58, 31, 20, 0.04);
}

.dim-icon {
  width: 44rpx;
  height: 44rpx;
}

.dim-name {
  font-size: 22rpx;
  color: #8B7355;
  font-weight: 500;
}

.error-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160rpx;
}

.error-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.error-emoji {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.error-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #3A1F14;
  margin-bottom: 12rpx;
}

.error-desc {
  font-size: 26rpx;
  color: #8B7355;
}

.page-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.footer-note {
  font-size: 22rpx;
  color: #B8A08A;
  margin-top: 8rpx;
}
