.page-container {
  min-height: 100vh;
  background-color: #FFF7F0;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  padding: 32rpx;
  padding-top: 24rpx;
}

.poster-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.poster-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #3A1F14;
  margin-bottom: 8rpx;
}

.poster-tip {
  font-size: 24rpx;
  color: #8B7355;
}

.poster-preview {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.poster-card {
  width: 620rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF7F0 100%);
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(58, 31, 20, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-main-title {
  margin-bottom: 12rpx;
  text-align: center;
}

.main-title-text {
  font-size: 34rpx;
  font-weight: 800;
  color: #3A1F14;
  line-height: 1.5;
}

.card-sub-title {
  margin-bottom: 36rpx;
  text-align: center;
}

.sub-title-text {
  font-size: 28rpx;
  color: #FF7A45;
  font-weight: 600;
}

.vs-section {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-bottom: 32rpx;
  gap: 20rpx;
}

.vs-player {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  gap: 8rpx;
}

.vs-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.avatar-self {
  background: linear-gradient(135deg, #FFE8D6, #FFD4B8);
  box-shadow: 0 4rpx 12rpx rgba(255, 179, 71, 0.25);
}

.avatar-friend {
  background: linear-gradient(135deg, #E8F4FD, #D4ECFA);
  box-shadow: 0 4rpx 12rpx rgba(91, 155, 213, 0.25);
}

.vs-emoji {
  font-size: 48rpx;
}

.avatar-placeholder {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #E8D5C4;
  position: relative;
}

.avatar-placeholder::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #D4BFA8;
  transform: translate(-50%, -70%);
}

.avatar-placeholder::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  width: 36rpx;
  height: 18rpx;
  border-radius: 18rpx 18rpx 0 0;
  background: #D4BFA8;
  transform: translateX(-50%);
}

.vs-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #3A1F14;
}

.vs-score {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}

.score-self {
  color: #FF7A45;
}

.score-friend {
  color: #5B9BD5;
}

.vs-level {
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.level-self {
  color: #FF7A45;
  background: #FFF0E6;
}

.level-friend {
  color: #5B9BD5;
  background: #EBF4FA;
}

.vs-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.vs-text {
  font-size: 36rpx;
  font-weight: 900;
  color: #FF7A45;
  text-shadow: 0 2rpx 8rpx rgba(255, 122, 69, 0.2);
}

.card-verdict {
  width: 100%;
  background: #FFF5EE;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 28rpx;
  text-align: center;
  border: 1rpx solid #FFE8D6;
}

.verdict-text {
  font-size: 26rpx;
  color: #3A1F14;
  font-weight: 600;
  line-height: 1.6;
}

.card-footer {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F0E6DC;
}

.footer-app {
  font-size: 28rpx;
  font-weight: 800;
  color: #FF7A45;
}

.footer-slogan {
  font-size: 20rpx;
  color: #8B7355;
  text-align: center;
  line-height: 1.5;
}

.page-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
