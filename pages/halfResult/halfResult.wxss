.page-container {
  min-height: 100vh;
  background-color: #FFF7F0;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  padding: 32rpx;
  padding-top: 24rpx;
}

.result-header {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #3A1F14;
}

.result-title .highlight {
  color: #FF7A45;
}

.score-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 28rpx;
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(58, 31, 20, 0.07);
}

.score-left {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.hero-img {
  width: 220rpx;
  height: 220rpx;
}

.score-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ring-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 16rpx;
}

.ring-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 16rpx solid #FFE8D6;
}

.ring-fill {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 16rpx solid #FF7A45;
  clip-path: polygon(50% 0%, 100% 0%, 100% 100%, 50% 100%, 50% 50%);
  transform-origin: 50% 50%;
  transition: transform 1.2s ease-out;
}

.ring-inner {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ring-label {
  font-size: 22rpx;
  color: #8B7355;
}

.ring-value {
  font-size: 52rpx;
  font-weight: 900;
  color: #FF7A45;
  line-height: 1.1;
}

.level-tag {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF0E6, #FFE8D6);
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.level-emoji {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.level-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #FF7A45;
}

.features-section {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3A1F14;
  margin-bottom: 20rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(58, 31, 20, 0.04);
}

.feature-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.feature-emoji {
  font-size: 34rpx;
}

.feature-info {
  flex: 1;
}

.feature-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3A1F14;
}

.feature-level {
  font-size: 24rpx;
  font-weight: 600;
}

.feature-bar {
  height: 14rpx;
  background: #F5EDE6;
  border-radius: 7rpx;
  overflow: hidden;
}

.feature-bar-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.6s ease;
}

.invite-card {
  background: linear-gradient(135deg, #FFF5EE, #FFE8D6);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.invite-top {
  margin-bottom: 12rpx;
}

.invite-icon {
  font-size: 48rpx;
}

.invite-content {
  margin-bottom: 24rpx;
}

.invite-text {
  display: block;
  font-size: 28rpx;
  color: #3A1F14;
  text-align: center;
  line-height: 1.7;
  font-weight: 500;
}

.invite-text .highlight {
  color: #FF7A45;
  font-weight: 700;
}

.invite-figures {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 20rpx;
}

.invite-person {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.invite-bubble {
  font-size: 22rpx;
  color: #FF7A45;
  background: #FFFFFF;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 122, 69, 0.15);
  font-weight: 600;
}

.invite-emoji {
  font-size: 48rpx;
}

.invite-vs {
  font-size: 40rpx;
  font-weight: 900;
  color: #FF7A45;
}

.invite-hint {
  font-size: 24rpx;
  color: #8B7355;
  font-weight: 500;
}

.page-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFF7F0;
}

.disclaimer {
  font-size: 22rpx;
  color: #B8A08A;
  margin-top: 8rpx;
}
