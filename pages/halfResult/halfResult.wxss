.page-container {
  min-height: 100vh;
  background-color: #FFF7F0;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  padding: 32rpx;
  padding-top: 24rpx;
}

.result-header {
  display: flex;
  justify-content: center;
  margin-bottom: 28rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #3A1F14;
}

.result-title .highlight {
  color: #FF7A45;
}

.status-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(58, 31, 20, 0.07);
}

.status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot.pulse {
  background: #FF7A45;
  animation: pulse-glow 1.8s ease-in-out infinite;
}

@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 122, 69, 0.4); }
  50% { box-shadow: 0 0 0 10rpx rgba(255, 122, 69, 0); }
}

.status-dot.dot-orange {
  background: #F5A623;
}

.status-divider {
  height: 1rpx;
  background: #F0E6DC;
  margin: 24rpx 0;
}

.status-label {
  font-size: 28rpx;
  color: #8B7355;
  font-weight: 500;
}

.status-value {
  font-size: 28rpx;
  color: #3A1F14;
  font-weight: 700;
}

.status-value.highlight {
  color: #FF7A45;
}

.identity-card {
  background: linear-gradient(135deg, #FFF8F2, #FFE8D6);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid #FFD4B8;
  box-shadow: 0 4rpx 16rpx rgba(255, 122, 69, 0.08);
}

.identity-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.identity-icon {
  width: 32rpx;
  height: 32rpx;
}

.identity-label {
  font-size: 24rpx;
  color: #8B7355;
  font-weight: 600;
}

.identity-value {
  font-size: 36rpx;
  font-weight: 900;
  color: #FF7A45;
  margin-bottom: 12rpx;
}

.identity-hint {
  font-size: 24rpx;
  color: #B8A08A;
  font-weight: 500;
}

.features-section {
  margin-bottom: 28rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3A1F14;
  margin-bottom: 20rpx;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(58, 31, 20, 0.04);
}

.feature-item.feature-revealed {
  border: 2rpx solid #FFD4B8;
}

.feature-item.feature-locked {
  border: 2rpx dashed #D8CFC5;
  background: #FAFAF8;
}

.feature-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.feature-img {
  width: 34rpx;
  height: 34rpx;
}

.icon-locked {
  background: #EDEDED;
}

.lock-shape {
  width: 24rpx;
  height: 20rpx;
  background: #C0C0C0;
  border-radius: 4rpx;
  position: relative;
}

.lock-shape::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  width: 16rpx;
  height: 14rpx;
  border: 3rpx solid #C0C0C0;
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
  transform: translateX(-50%);
  background: transparent;
}

.feature-info {
  flex: 1;
}

.feature-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3A1F14;
}

.feature-name-locked {
  color: #B8A08A;
}

.feature-level {
  font-size: 24rpx;
  font-weight: 600;
}

.level-locked {
  color: #C0C0C0;
}

.feature-bar {
  height: 14rpx;
  background: #F5EDE6;
  border-radius: 7rpx;
  overflow: hidden;
}

.feature-bar-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.6s ease;
}

.bar-locked {
  width: 30%;
  background: #D8D8D8;
}

.invite-card {
  background: linear-gradient(135deg, #FFF5EE, #FFE8D6);
  border-radius: 32rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.invite-top {
  margin-bottom: 12rpx;
}

.invite-icon {
  width: 48rpx;
  height: 48rpx;
}

.invite-content {
  margin-bottom: 24rpx;
}

.invite-text {
  display: block;
  font-size: 28rpx;
  color: #3A1F14;
  text-align: center;
  line-height: 1.7;
  font-weight: 500;
}

.invite-text .highlight {
  color: #FF7A45;
  font-weight: 700;
}

.invite-figures {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 20rpx;
}

.invite-person {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.invite-bubble {
  font-size: 22rpx;
  color: #FF7A45;
  background: #FFFFFF;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 122, 69, 0.15);
  font-weight: 600;
}

.invite-vs {
  font-size: 40rpx;
  font-weight: 900;
  color: #FF7A45;
}

.invite-hint {
  font-size: 24rpx;
  color: #8B7355;
  font-weight: 500;
}

.invite-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE8D6, #FFD4B8);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-placeholder-inv {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E8D5C4;
  position: relative;
}

.avatar-placeholder-inv::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #D4BFA8;
  transform: translate(-50%, -70%);
}

.avatar-placeholder-inv::after {
  content: '';
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  width: 28rpx;
  height: 14rpx;
  border-radius: 14rpx 14rpx 0 0;
  background: #D4BFA8;
  transform: translateX(-50%);
}

.page-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFF7F0;
}

.disclaimer {
  font-size: 22rpx;
  color: #B8A08A;
  margin-top: 8rpx;
}
