.page-container {
  min-height: 100vh;
  background-color: #FFF7F0;
  display: flex;
  flex-direction: column;
}

.page-content {
  flex: 1;
  padding: 32rpx;
  padding-top: 24rpx;
}

.result-header {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #3A1F14;
}

.result-title .highlight {
  color: #FF7A45;
}

.winner-banner {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(135deg, #FF4444, #FF6B35);
  border-radius: 24rpx;
  padding: 24rpx 40rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 68, 68, 0.25);
}

.banner-crown {
  font-size: 48rpx;
  margin-bottom: 4rpx;
}

.banner-text {
  font-size: 34rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.battle-section {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.player-card {
  flex: 1;
  max-width: 290rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx 16rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  border: 3rpx solid transparent;
  box-shadow: 0 4rpx 16rpx rgba(58, 31, 20, 0.06);
}

.player-card.card-winner {
  border-color: #FFB088;
  background: linear-gradient(180deg, #FFF8F2 0%, #FFFFFF 100%);
  box-shadow: 0 8rpx 28rpx rgba(255, 122, 69, 0.18);
}

.player-card.card-loser {
  border-color: #B8D4EC;
  background: linear-gradient(180deg, #F5FAFD 0%, #FFFFFF 100%);
  box-shadow: 0 4rpx 16rpx rgba(91, 155, 213, 0.1);
}

.card-crown {
  position: absolute;
  top: -24rpx;
  font-size: 40rpx;
  filter: drop-shadow(0 2rpx 6rpx rgba(255, 165, 0, 0.4));
}

.player-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
}

.player-avatar.avatar-winner {
  background: linear-gradient(135deg, #FFE8D6, #FFD4B8);
  box-shadow: 0 4rpx 16rpx rgba(255, 122, 69, 0.25);
}

.player-avatar.avatar-loser {
  background: linear-gradient(135deg, #E8F4FD, #D4ECFA);
  box-shadow: 0 4rpx 16rpx rgba(91, 155, 213, 0.2);
}

.avatar-img {
  width: 80rpx;
  height: 80rpx;
}

.avatar-emoji {
  font-size: 52rpx;
}

.player-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #3A1F14;
  margin-bottom: 8rpx;
}

.player-score {
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.1;
  margin-bottom: 4rpx;
}

.player-level {
  font-size: 22rpx;
  color: #8B7355;
  font-weight: 500;
}

.vs-block {
  flex-shrink: 0;
  width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 60rpx;
}

.vs-text {
  font-size: 44rpx;
  font-weight: 900;
  color: #FF7A45;
  text-shadow: 0 2rpx 8rpx rgba(255, 122, 69, 0.3);
}

.features-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3A1F14;
  margin-bottom: 16rpx;
}

.feature-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.feature-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
}

.tag-emoji {
  font-size: 26rpx;
}

.tag-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #3A1F14;
}

.comment-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(58, 31, 20, 0.04);
  border-left: 6rpx solid #FF7A45;
}

.comment-text {
  font-size: 28rpx;
  color: #3A1F14;
  line-height: 1.7;
  font-weight: 500;
}

.page-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.disclaimer {
  font-size: 22rpx;
  color: #B8A08A;
  margin-top: 4rpx;
}
