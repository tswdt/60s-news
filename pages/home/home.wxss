.page-container {
  min-height: 100vh;
  background-color: #FFF7F0;
}

.page-content {
  padding: 32rpx;
  padding-top: 60rpx;
}

.title-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.main-title {
  font-size: 72rpx;
  font-weight: 900;
  color: #3A1F14;
  line-height: 1.2;
  margin-bottom: 16rpx;
  text-align: center;
}

.main-title .highlight {
  color: #FF7A45;
}

.sub-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #FF7A45;
  background: linear-gradient(135deg, #FFF0E6 0%, #FFE0CC 100%);
  padding: 8rpx 32rpx;
  border-radius: 24rpx;
  margin-bottom: 12rpx;
}

.desc-text {
  font-size: 24rpx;
  color: #8B7355;
  text-align: center;
}

.illustration-section {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.illustration-box {
  width: 100%;
  height: 320rpx;
  background: linear-gradient(180deg, #FFF5EB 0%, #FFF7F0 100%);
  border-radius: 32rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.speech-bubble {
  position: absolute;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.speech-bubble.left {
  left: 40rpx;
  top: 60rpx;
  background: #FFF0E6;
  color: #FF7A45;
}

.speech-bubble.right {
  right: 40rpx;
  top: 60rpx;
  background: #E3F2FD;
  color: #2196F3;
}

.center-figure {
  position: absolute;
  bottom: 40rpx;
}

.figure-circle {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #FFE0CC 0%, #FFD4B8 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.figure-img {
  width: 80rpx;
  height: 80rpx;
}

.side-figure {
  position: absolute;
  bottom: 60rpx;
}

.left-figure {
  left: 60rpx;
}

.right-figure {
  right: 60rpx;
}

.side-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8F4FD, #D4ECFA);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-placeholder-sm {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #B8D4EC;
  position: relative;
}

.avatar-placeholder-sm::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #9BBDD9;
  transform: translate(-50%, -70%);
}

.avatar-placeholder-sm::after {
  content: '';
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  width: 28rpx;
  height: 14rpx;
  border-radius: 14rpx 14rpx 0 0;
  background: #9BBDD9;
  transform: translateX(-50%);
}

.action-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.dimension-section {
  margin-top: auto;
}

.dimension-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3A1F14;
  text-align: center;
  margin-bottom: 24rpx;
}

.dimension-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
}

.dimension-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.dimension-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.dimension-img {
  width: 40rpx;
  height: 40rpx;
}

.dimension-label {
  font-size: 22rpx;
  color: #8B7355;
  text-align: center;
}
