.page {
  padding: 32rpx;
  padding-bottom: 180rpx;
}

.hero {
  text-align: center;
  padding: 40rpx 0 32rpx;
}

.hero-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 12rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  display: block;
  color: #6366F1;
}

.hero-desc {
  font-size: 26rpx;
  color: #64748B;
  display: block;
  margin-top: 8rpx;
}

.section {
  margin-top: 32rpx;
}

.section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #64748B;
  display: block;
  margin-bottom: 16rpx;
}

.subject-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.subject-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(33.33% - 8rpx);
  padding: 16rpx 0;
  border: 2rpx solid #E2E8F0;
  border-radius: 12rpx;
  background: white;
}

.subject-btn.active {
  border-color: #6366F1;
  background: #EEF2FF;
  box-shadow: 0 0 0 4rpx rgba(99, 102, 241, 0.15);
}

.subject-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.subject-name {
  font-size: 22rpx;
  font-weight: 500;
}

.grade-groups {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.grade-group {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.grade-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #64748B;
  min-width: 56rpx;
}

.grade-btns {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.grade-btn {
  padding: 8rpx 20rpx;
  border: 1rpx solid #E2E8F0;
  border-radius: 28rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: white;
}

.grade-btn.active {
  background: #6366F1;
  color: white;
  border-color: #6366F1;
}

.model-row {
  display: flex;
  gap: 16rpx;
}

.model-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  background: white;
  font-size: 24rpx;
  font-weight: 500;
}

.model-btn.active {
  border-color: #6366F1;
  background: #EEF2FF;
}

.model-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #94A3B8;
}

.model-dot.active {
  background: #10B981;
}

.quick-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.quick-item {
  padding: 16rpx 20rpx;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  background: white;
  font-size: 26rpx;
  color: #1E293B;
}

.start-area {
  margin-top: 48rpx;
  padding: 0 16rpx;
}

.start-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #6366F1;
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
}
