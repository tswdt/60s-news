.page {
  padding: 32rpx;
  min-height: 100vh;
  background: #F1F5F9;
}

.placeholder-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  background: white;
  border-radius: 16rpx;
  border: 1rpx solid #E2E8F0;
  margin-top: 80rpx;
}

.placeholder-icon {
  font-size: 72rpx;
  margin-bottom: 24rpx;
}

.placeholder-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1E293B;
  margin-bottom: 12rpx;
}

.placeholder-desc {
  font-size: 26rpx;
  color: #94A3B8;
  margin-bottom: 24rpx;
}

.placeholder-badge {
  font-size: 22rpx;
  color: #6366F1;
  background: #EEF2FF;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}
